#!/usr/bin/env node
/**
 * yeet — unified agent platform CLI
 *
 * One CLI for all platform operations: projects, secrets, contacts.
 * Authenticates via FAT_TOOLS_TOKEN environment variable.
 */

const { execSync } = require("child_process");
const fs = require("fs");
const path = require("path");
const os = require("os");

const DEPLOY_URL = "https://deploy.tinyfat.com";
const PLATFORM_URL = "https://tinyfat.com";
const SITES_PUBLISH_URL = process.env.TINYFAT_SITES_PUBLISH_URL || "https://publish.tinyfat.com/api/sites";

function getToken() {
  const token = process.env.FAT_TOOLS_TOKEN;
  if (!token) {
    console.error("Error: FAT_TOOLS_TOKEN not set");
    process.exit(1);
  }
  return token;
}

async function api(url, opts = {}) {
  const token = getToken();
  const headers = {
    Authorization: `Bearer ${token}`,
    ...opts.headers,
  };
  const res = await fetch(url, { ...opts, headers });
  const text = await res.text();
  try {
    return { ok: res.ok, status: res.status, data: JSON.parse(text) };
  } catch {
    return { ok: res.ok, status: res.status, data: text };
  }
}

// -- TinyFat site project helpers --------------------------------

const PROJECT_FILE = "yeet.json";
const PROJECT_KIND_SITE = "site";
const PROJECT_KIND_PAGES = "legacy-pages";
const PROJECT_NAME_MAX = 55;
const PREVIEW_APEX = "preview.tinyfat.dev";
const SITE_RESOURCE_TYPES = new Set(["d1", "kv", "r2"]);
const DATA_DIR = process.env.YEET_DATA_DIR || "/data";
const PROJECTS_ROOT = process.env.YEET_PROJECTS_DIR || (
  fs.existsSync(DATA_DIR) ? path.join(DATA_DIR, "projects") : path.join(process.cwd(), "projects")
);
const WORKSPACE_DEPLOY_DIR = "site";

function projectWorkspaceDir(projectName) {
  return path.join(PROJECTS_ROOT, cleanProjectName(projectName));
}

function ensureDir(dir) {
  fs.mkdirSync(dir, { recursive: true });
}

function writeFileIfMissing(file, contents) {
  if (!fs.existsSync(file)) {
    fs.writeFileSync(file, contents);
  }
}

function projectBriefTemplate(projectName, site = {}) {
  const url = site.production_url || site.preview_url || siteUrlFor(projectName, "production");
  const state = site.state || "preview";
  return [
    `# ${projectName}`,
    "",
    `Slug: ${projectName}`,
    `State: ${state}`,
    `Canonical preview: ${url}`,
    "",
    "## Brief",
    "",
    "TBD",
    "",
    "## Current Notes",
    "",
    "- Source lives in `site/`.",
    "- Deploy from this directory with `yeet project deploy`.",
    "",
  ].join("\n");
}

function ensureProjectWorkspace(projectName, site = {}) {
  const name = cleanProjectName(projectName);
  const workspaceDir = projectWorkspaceDir(name);
  const sourceDir = path.join(workspaceDir, WORKSPACE_DEPLOY_DIR);
  const threadsDir = path.join(workspaceDir, "threads");

  ensureDir(sourceDir);
  ensureDir(threadsDir);
  writeFileIfMissing(path.join(workspaceDir, "PROJECT.md"), projectBriefTemplate(name, site));
  writeFileIfMissing(path.join(workspaceDir, "tasks.md"), `# ${name} Tasks\n\n`);
  writeFileIfMissing(path.join(workspaceDir, "deploys.jsonl"), "");
  writeFileIfMissing(path.join(threadsDir, "default.jsonl"), "");

  writeProjectConfig({
    name,
    kind: PROJECT_KIND_SITE,
    deployDir: WORKSPACE_DEPLOY_DIR,
    workspace: {
      root: workspaceDir,
      sourceDir: WORKSPACE_DEPLOY_DIR,
      projectFile: "PROJECT.md",
      threadsDir: "threads",
      deployLog: "deploys.jsonl",
      tasksFile: "tasks.md",
    },
    updatedAt: new Date().toISOString(),
  }, workspaceDir);

  return { workspaceDir, sourceDir, deployDir: WORKSPACE_DEPLOY_DIR };
}

function conventionalDeployDir(projectName) {
  const sourceDir = path.join(projectWorkspaceDir(projectName), WORKSPACE_DEPLOY_DIR);
  return isDirectory(sourceDir) ? sourceDir : null;
}

function recordProjectDeployment(projectName, environment, data) {
  const workspaceDir = projectWorkspaceDir(projectName);
  const logFile = path.join(workspaceDir, "deploys.jsonl");
  if (!fs.existsSync(logFile)) return;

  const row = {
    at: new Date().toISOString(),
    environment,
    url: data.url || null,
    deploymentId: data.deploymentId || data.deployment?.id || null,
    state: data.deployment?.state || null,
    files: data.files || null,
  };
  fs.appendFileSync(logFile, `${JSON.stringify(row)}\n`);
}

function splitFlags(args) {
  const flags = new Set();
  const positional = [];
  for (const arg of args) {
    if (arg.startsWith("--")) flags.add(arg);
    else positional.push(arg);
  }
  return { flags, positional };
}

function cleanProjectName(value) {
  const name = String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, PROJECT_NAME_MAX);

  if (!/^[a-z0-9](?:[a-z0-9-]{0,53}[a-z0-9])?$/.test(name)) {
    console.error("Error: project name must contain letters or numbers and may use dashes");
    process.exit(1);
  }
  return name;
}

function projectConfigPath(dir = process.cwd()) {
  return path.join(dir, PROJECT_FILE);
}

function readProjectConfig(dir = process.cwd()) {
  const file = projectConfigPath(dir);
  if (!fs.existsSync(file)) return null;
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (err) {
    console.error(`Warning: could not read ${PROJECT_FILE}: ${err.message}`);
    return null;
  }
}

function writeProjectConfig(config, dir = process.cwd()) {
  fs.writeFileSync(projectConfigPath(dir), `${JSON.stringify(config, null, 2)}\n`);
}

function isDirectory(value) {
  try {
    return fs.statSync(value).isDirectory();
  } catch {
    return false;
  }
}

function createTarball(dir, prefix) {
  if (!fs.existsSync(dir) || !fs.statSync(dir).isDirectory()) {
    console.error(`Error: ${dir} is not a directory`);
    process.exit(1);
  }

  const tarball = path.join(os.tmpdir(), `${prefix}-${Date.now()}.tar.gz`);
  try {
    execSync(`tar -czf "${tarball}" -C "${dir}" .`, { stdio: "pipe" });
  } catch (err) {
    console.error("Error creating tarball:", err.message);
    process.exit(1);
  }

  const body = fs.readFileSync(tarball);
  const size = fs.statSync(tarball).size;
  fs.unlinkSync(tarball);
  return { body, size };
}

function siteUrlFor(projectName, environment) {
  const scriptName = environment === "preview" ? `${projectName}-preview` : projectName;
  return `https://${scriptName}.${PREVIEW_APEX}/`;
}

function resolveProjectDeploy(args) {
  const { flags, positional } = splitFlags(args);
  const config = readProjectConfig();
  const legacyPages = flags.has("--pages") || (!flags.has("--site") && config?.kind === PROJECT_KIND_PAGES);
  const environment = flags.has("--preview") ? "preview" : "production";
  let projectName = null;
  let dir = config?.deployDir || ".";

  if (positional.length >= 2) {
    projectName = positional[0];
    dir = positional[1];
  } else if (positional.length === 1) {
    const only = positional[0];
    const onlyIsDirectory = isDirectory(only);
    if (config?.name && onlyIsDirectory) {
      projectName = config.name;
      dir = only;
    } else if (!config?.name && onlyIsDirectory) {
      console.error(`Error: "${only}" is a directory, but no ${PROJECT_FILE} was found.`);
      console.error("Run from the directory with yeet.json, or use: yeet project deploy <name> <directory>");
      process.exit(1);
    } else {
      projectName = only;
    }
  } else if (config?.name) {
    projectName = config.name;
  }

  if (!projectName) {
    console.error("Usage with config: yeet project deploy [directory] [--preview|--pages]");
    console.error("Usage without config: yeet project deploy <name> <directory> [--preview|--pages]");
    console.error("First run: yeet project init <name> [directory]");
    process.exit(1);
  }

  const cleanName = cleanProjectName(projectName);
  if (!legacyPages && positional.length === 1 && !isDirectory(positional[0]) && !config?.name) {
    dir = conventionalDeployDir(cleanName) || dir;
  }

  return {
    projectName: cleanName,
    dir,
    environment,
    legacyPages,
  };
}

async function deploySiteProject(projectName, dir, environment = "production") {
  const { body, size } = createTarball(dir, "yeet-site");
  console.log(`Publishing ${dir} to TinyFat site project ${projectName} (${environment}, ${(size / 1024).toFixed(0)}KB)...`);

  const res = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}/deploy`, {
    method: "POST",
    headers: {
      "Content-Type": "application/gzip",
      "X-Environment": environment,
    },
    body,
  });

  if (res.ok && res.data.url) {
    recordProjectDeployment(projectName, environment, res.data);
    console.log(`\nPublished: ${res.data.url}`);
    if (res.data.site) console.log(`Project:   ${res.data.site}`);
    if (res.data.namespace) console.log(`Namespace: ${res.data.namespace}`);
    if (Array.isArray(res.data.bindings)) {
      const bindings = res.data.bindings.map((binding) => binding.name).filter(Boolean);
      if (bindings.length > 0) console.log(`Bindings:  ${bindings.join(", ")}`);
    }
    return;
  }

  console.error("Publish failed:", res.data.error || res.data);
  process.exit(1);
}

async function deployLegacyPagesProject(projectName, dir) {
  const { body, size } = createTarball(dir, "yeet-deploy");
  console.log(`Deploying ${dir} to legacy Pages project ${projectName} (${(size / 1024).toFixed(0)}KB)...`);

  const res = await api(DEPLOY_URL, {
    method: "POST",
    headers: {
      "Content-Type": "application/gzip",
      "X-Project-Name": projectName,
    },
    body,
  });

  if (res.ok && res.data.url) {
    console.log(`\nDeployed: ${res.data.url}`);
    if (res.data.project) console.log(`Project:  ${res.data.project}`);
    return;
  }

  console.error("Deploy failed:", res.data.error || res.data);
  process.exit(1);
}

// -- project deploy ------------------------------------------

async function projectDeploy(args) {
  const { projectName, dir, environment, legacyPages } = resolveProjectDeploy(args);
  if (legacyPages) return deployLegacyPagesProject(projectName, dir);
  return deploySiteProject(projectName, dir, environment);
}

// -- site deploy (direct alias) ------------------------------

async function siteDeploy(args) {
  const { flags, positional } = splitFlags(args);
  if (positional.length < 1) {
    console.error("Usage: yeet site deploy <name> [directory] [--preview]");
    process.exit(1);
  }
  const siteName = cleanProjectName(positional[0]);
  const dir = positional[1] || ".";
  const environment = flags.has("--preview") ? "preview" : "production";
  return deploySiteProject(siteName, dir, environment);
}

async function siteCmd(args) {
  if (args.length === 0) {
    console.error("Usage: yeet site <deploy> [args]");
    process.exit(1);
  }
  const sub = args[0];
  const rest = args.slice(1);

  switch (sub) {
    case "deploy":
      return siteDeploy(rest);
    default:
      console.error(`Unknown site command: ${sub}`);
      console.error("Usage: yeet site <deploy> [args]");
      process.exit(1);
  }
}

// ── project env ─────────────────────────────────────────────

async function projectEnv(args) {
  if (args.length < 2) {
    console.error("Usage: yeet project env <project> set|rm|ls [KEY] [VALUE]");
    process.exit(1);
  }
  const project = args[0];
  const action = args[1];

  if (action === "ls") {
    // List env vars — the deploy worker doesn't have a list endpoint yet,
    // so we inform the user this is a Phase 2 feature
    console.error("Listing project env vars is not yet supported.");
    console.error("You can set and remove vars. Use the CF dashboard to view them.");
    process.exit(1);
  }

  if (action === "set") {
    if (args.length < 3) {
      console.error("Usage: yeet project env <project> set KEY=VALUE");
      process.exit(1);
    }
    // Support KEY=VALUE or KEY VALUE
    let key, value;
    if (args[2].includes("=")) {
      [key, ...rest] = args[2].split("=");
      value = rest.join("=");
    } else {
      key = args[2];
      value = args[3];
    }
    if (!key || value === undefined) {
      console.error("Usage: yeet project env <project> set KEY=VALUE");
      process.exit(1);
    }

    const payload = {
      project,
      env: "production",
      vars: { [key]: { value, type: "secret_text" } },
    };

    const res = await api(`${DEPLOY_URL}/secret`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (res.ok && res.data.success) {
      console.log(`Set ${key} on ${project} (production)`);
    } else {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
  } else if (action === "rm") {
    if (args.length < 3) {
      console.error("Usage: yeet project env <project> rm KEY");
      process.exit(1);
    }
    const key = args[2];
    const payload = {
      project,
      env: "production",
      vars: { [key]: null },
    };

    const res = await api(`${DEPLOY_URL}/secret`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (res.ok && res.data.success) {
      console.log(`Removed ${key} from ${project} (production)`);
    } else {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
  } else {
    console.error(`Unknown action: ${action}`);
    console.error("Usage: yeet project env <project> set|rm|ls [KEY] [VALUE]");
    process.exit(1);
  }
}

// -- project resources ---------------------------------------

function projectResourcesUsage() {
  console.error("Usage: yeet project resources ls [project]");
  console.error("Usage: yeet project resources add <type> [binding] [--shared|--preview|--production]");
  console.error("Usage: yeet project resources add <project> <type> [binding] [--shared|--preview|--production]");
  console.error("Types: d1, kv, r2. Default bindings: DB, SESSION, MEDIA.");
}

function siteResourceEnvironment(flags) {
  const selected = ["--shared", "--preview", "--production"].filter((flag) => flags.has(flag));
  if (selected.length > 1) {
    console.error("Error: choose only one of --shared, --preview, or --production");
    process.exit(1);
  }
  if (flags.has("--preview")) return "preview";
  if (flags.has("--production")) return "production";
  return "shared";
}

function isSiteResourceType(value) {
  return SITE_RESOURCE_TYPES.has(String(value || "").toLowerCase());
}

function resolveResourceProjectName(value) {
  const config = readProjectConfig();
  const projectName = value || config?.name;
  if (!projectName) {
    projectResourcesUsage();
    console.error("First run: yeet project init <name>");
    process.exit(1);
  }
  return cleanProjectName(projectName);
}

function resolveResourceAdd(positional) {
  const config = readProjectConfig();
  const values = positional.slice(1);
  let projectName;
  let type;
  let binding;

  if (config?.name && isSiteResourceType(values[0])) {
    projectName = config.name;
    type = values[0];
    binding = values[1];
  } else if (values.length >= 2) {
    projectName = values[0];
    type = values[1];
    binding = values[2];
  }

  if (!projectName || !type || !isSiteResourceType(type)) {
    projectResourcesUsage();
    process.exit(1);
  }

  return {
    projectName: cleanProjectName(projectName),
    type: String(type).toLowerCase(),
    binding,
  };
}

function printSiteResources(projectName, resources) {
  if (resources.length === 0) {
    console.log(`No resources on ${projectName}. Add one with: yeet project resources add d1`);
    return;
  }

  console.log(`Resources for ${projectName}:`);
  console.log("  binding     type  environment  state         cloudflare name");
  for (const resource of resources) {
    const binding = String(resource.binding || "-").padEnd(10);
    const type = String(resource.type || "-").padEnd(4);
    const environment = String(resource.environment || "shared").padEnd(12);
    const state = String(resource.state || "-").padEnd(13);
    const cfName = resource.cfName || resource.cf_name || "-";
    console.log(`  ${binding}  ${type}  ${environment} ${state} ${cfName}`);
  }
}

async function projectResources(args) {
  const { flags, positional } = splitFlags(args);
  const action = positional[0];
  if (!action) {
    projectResourcesUsage();
    process.exit(1);
  }

  if (action === "ls" || action === "list") {
    const projectName = resolveResourceProjectName(positional[1]);
    const res = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}/resources`);
    if (!res.ok) {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
    printSiteResources(projectName, res.data.resources || []);
    return;
  }

  if (action === "add") {
    const { projectName, type, binding } = resolveResourceAdd(positional);
    const environment = siteResourceEnvironment(flags);
    const body = { type, environment };
    if (binding) body.binding = binding;

    const res = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}/resources`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });

    if (!res.ok) {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }

    const resource = res.data.resource || {};
    const status = res.data.created === false ? "Already active" : "Provisioned";
    console.log(`${status}: ${resource.type || type} ${resource.binding || binding || ""}`.trim());
    if (resource.environment) console.log(`Environment: ${resource.environment}`);
    if (resource.cfName) console.log(`Resource:    ${resource.cfName}`);
    console.log("Deploy again to attach the binding to the Worker.");
    return;
  }

  projectResourcesUsage();
  process.exit(1);
}

// -- project init/use/list/info --------------------------------

function projectUse(args) {
  const { flags, positional } = splitFlags(args);
  if (positional.length < 1) {
    console.error("Usage: yeet project use <name> [directory] [--pages]");
    process.exit(1);
  }

  const name = cleanProjectName(positional[0]);
  const explicitDeployDir = positional.length >= 2;
  const deployDir = positional[1] || ".";
  const kind = flags.has("--pages") ? PROJECT_KIND_PAGES : PROJECT_KIND_SITE;

  if (kind === PROJECT_KIND_SITE && !explicitDeployDir) {
    const workspace = ensureProjectWorkspace(name);
    console.log(`Project:   ${name}`);
    console.log(`Workspace: ${workspace.workspaceDir}`);
    console.log(`Config:    ${path.join(workspace.workspaceDir, PROJECT_FILE)}`);
    console.log(`URL:       ${siteUrlFor(name, "production")}`);
    console.log(`Deploy dir: ${workspace.deployDir}`);
    console.log("Deploy:    cd " + workspace.workspaceDir + " && yeet project deploy");
    return;
  }

  writeProjectConfig({
    name,
    kind,
    deployDir,
    updatedAt: new Date().toISOString(),
  });

  console.log(`Project: ${name}`);
  console.log(`Config:  ${PROJECT_FILE}`);
  if (kind === PROJECT_KIND_SITE) {
    console.log(`URL:     ${siteUrlFor(name, "production")}`);
    console.log(`Deploy dir: ${deployDir}`);
    console.log("Deploy:  yeet project deploy");
  } else {
    console.log("Kind:    legacy Cloudflare Pages");
    console.log(`Deploy dir: ${deployDir}`);
    console.log("Deploy:  yeet project deploy --pages");
  }
}

async function projectInit(args) {
  const { flags, positional } = splitFlags(args);
  if (positional.length < 1) {
    console.error("Usage: yeet project init <name> [directory] [--pages]");
    process.exit(1);
  }

  if (flags.has("--pages")) {
    return legacyProjectInit(positional[0]);
  }

  const name = cleanProjectName(positional[0]);
  const explicitDeployDir = positional.length >= 2;
  const deployDir = positional[1] || ".";
  console.log(`Creating TinyFat site project ${name}...`);
  const res = await api(SITES_PUBLISH_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ slug: name, displayName: name }),
  });

  if (!res.ok) {
    console.error("Error:", res.data.error || res.data);
    process.exit(1);
  }

  if (!explicitDeployDir) {
    const workspace = ensureProjectWorkspace(name, res.data.site || {});
    console.log(res.data.created === false ? `Already exists: ${name}` : `Created: ${name}`);
    console.log(`Workspace: ${workspace.workspaceDir}`);
    console.log(`Config:    ${path.join(workspace.workspaceDir, PROJECT_FILE)}`);
    console.log(`URL:       ${res.data.site?.production_url || siteUrlFor(name, "production")}`);
    console.log(`Preview:   ${res.data.site?.preview_url || siteUrlFor(name, "preview")}`);
    console.log(`Deploy dir: ${workspace.deployDir}`);
    console.log("Deploy:    cd " + workspace.workspaceDir + " && yeet project deploy");
    return;
  }

  writeProjectConfig({
    name,
    kind: PROJECT_KIND_SITE,
    deployDir,
    updatedAt: new Date().toISOString(),
  });

  console.log(res.data.created === false ? `Already exists: ${name}` : `Created: ${name}`);
  console.log(`Config:  ${PROJECT_FILE}`);
  console.log(`URL:     ${res.data.site?.production_url || siteUrlFor(name, "production")}`);
  console.log(`Preview: ${res.data.site?.preview_url || siteUrlFor(name, "preview")}`);
  console.log(`Deploy dir: ${deployDir}`);
  console.log("Deploy:  yeet project deploy");
}

async function legacyProjectInit(name) {
  console.log(`Creating legacy Pages project ${name}...`);
  const res = await api(`${DEPLOY_URL}/init`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ project: name }),
  });

  if (res.ok) {
    if (res.data.created) {
      console.log(`Created: ${res.data.project}`);
    } else {
      console.log(`Already exists: ${res.data.project}`);
    }
    console.log(`URL: https://${res.data.subdomain}`);
  } else {
    console.error("Error:", res.data.error || res.data);
    process.exit(1);
  }
}

async function projectLs(args = []) {
  const { flags } = splitFlags(args);
  if (flags.has("--pages")) return legacyProjectLs();

  const res = await api(SITES_PUBLISH_URL);
  if (res.ok) {
    const sites = res.data.sites || [];
    if (sites.length === 0) {
      console.log("No site projects. Create one with: yeet project init <name>");
      return;
    }

    console.log("Site projects:");
    for (const site of sites) {
      const url = site.production_url || site.preview_url || siteUrlFor(site.slug, "production");
      console.log(`  ${site.slug}  ${url}`);
    }
    return;
  }

  console.error("Error:", res.data.error || res.data);
  process.exit(1);
}

async function legacyProjectLs() {
  const res = await api(`${DEPLOY_URL}/projects`);

  if (res.ok) {
    const projects = res.data.projects || [];
    if (projects.length === 0) {
      console.log("No legacy Pages projects. Create one with: yeet project init <name> --pages");
    } else {
      console.log("Legacy Pages projects:");
      for (const p of projects) {
        console.log(`  ${p.shortName}  https://${p.subdomain}`);
      }
    }
  } else {
    console.error("Error:", res.data.error || res.data);
    process.exit(1);
  }
}

async function projectInfo(args) {
  const { flags, positional } = splitFlags(args);
  const config = readProjectConfig();
  const usePages = flags.has("--pages") || (!flags.has("--site") && config?.kind === PROJECT_KIND_PAGES);
  const name = positional[0] || config?.name;

  if (!name) {
    console.error("Usage: yeet project info [name] [--pages]");
    console.error("First run: yeet project init <name>");
    process.exit(1);
  }

  if (usePages) return legacyProjectInfo(name);

  const projectName = cleanProjectName(name);
  const res = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}`);
  if (!res.ok) {
    if (res.status === 404) {
      console.log(`Project: ${projectName}`);
      console.log("No remote site record yet. Create one with: yeet project init " + projectName);
      return;
    }
    console.error("Error:", res.data.error || res.data);
    process.exit(1);
  }

  const site = res.data.site;
  console.log(`Project: ${site.slug}`);
  console.log(`URL:     ${site.production_url || siteUrlFor(site.slug, "production")}`);
  console.log(`Preview: ${site.preview_url || siteUrlFor(site.slug, "preview")}`);
  console.log(`State:   ${site.state}`);

  const deploys = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}/deployments`);
  if (deploys.ok && (deploys.data.deployments || []).length > 0) {
    console.log("\nRecent deploys:");
    for (const d of deploys.data.deployments) {
      const date = new Date(d.deployed_at || d.created_at).toLocaleString();
      const ready = d.metadata?.bundleKey ? "rollback-ready" : "history-only";
      console.log(`  ${date}  ${d.environment}  ${d.state}  ${ready}  ${d.id}  ${d.deployment_url}`);
    }
  } else {
    console.log("\nNo deploys yet. Deploy with: yeet project deploy");
  }
}

function deploymentHasBundle(deploy) {
  return Boolean(deploy?.metadata?.bundleKey);
}

async function chooseDeploymentForAction(projectName, action, explicitDeploymentId) {
  if (explicitDeploymentId) return explicitDeploymentId;

  const deploys = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}/deployments`);
  if (!deploys.ok) {
    console.error("Error:", deploys.data.error || deploys.data);
    process.exit(1);
  }

  const rows = deploys.data.deployments || [];
  const candidate = rows.find((deploy) => {
    if (!deploymentHasBundle(deploy)) return false;
    if (deploy.state === "failed" || deploy.state === "in_progress") return false;
    if (action === "promote") return deploy.environment === "preview";
    return deploy.state !== "live" && deploy.state !== "preview";
  });

  if (!candidate) {
    console.error(action === "promote"
      ? "No rollback-ready preview deploy found. Run `yeet project deploy --preview` first."
      : "No previous rollback-ready deploy found. Run `yeet project info` to inspect deploy history.");
    process.exit(1);
  }

  return candidate.id;
}

async function projectDeploymentAction(args, action) {
  const { positional } = splitFlags(args);
  const config = readProjectConfig();
  const projectName = cleanProjectName(positional[0] || config?.name || "");
  const deploymentId = positional[1];

  if (!projectName) {
    console.error(`Usage: yeet project ${action} [project] [deployment-id]`);
    console.error("First run: yeet project init <name>");
    process.exit(1);
  }

  const targetDeploymentId = await chooseDeploymentForAction(projectName, action, deploymentId);
  const res = await api(`${SITES_PUBLISH_URL}/${encodeURIComponent(projectName)}/deployments/${encodeURIComponent(targetDeploymentId)}/${action}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({}),
  });

  if (res.ok && res.data.url) {
    recordProjectDeployment(projectName, res.data.environment || "production", res.data);
    const label = action === "promote" ? "Promoted" : "Rolled back";
    console.log(`\n${label}: ${res.data.url}`);
    if (res.data.sourceDeploymentId) console.log(`Source:  ${res.data.sourceDeploymentId}`);
    if (res.data.deployment?.id) console.log(`Deploy:  ${res.data.deployment.id}`);
    return;
  }

  console.error(`${action === "promote" ? "Promote" : "Rollback"} failed:`, res.data.error || res.data);
  process.exit(1);
}

async function projectRollback(args) {
  return projectDeploymentAction(args, "rollback");
}

async function projectPromote(args) {
  return projectDeploymentAction(args, "promote");
}

async function legacyProjectInfo(name) {
  const res = await api(`${DEPLOY_URL}/projects/${encodeURIComponent(name)}`);

  if (res.ok) {
    console.log(`Project: ${res.data.shortName}`);
    console.log(`Full name: ${res.data.project}`);
    console.log(`URL: https://${res.data.subdomain}`);
    const deploys = res.data.deploys || [];
    if (deploys.length > 0) {
      console.log(`\nRecent deploys:`);
      for (const d of deploys) {
        const date = new Date(d.created_at).toLocaleString();
        const branch = d.branch ? ` (${d.branch})` : "";
        console.log(`  ${date}${branch}  ${d.deployment_url}`);
      }
    } else {
      console.log("\nNo deploys yet. Deploy with: yeet project deploy " + name + " <dir> --pages");
    }
  } else {
    console.error("Error:", res.data.error || res.data);
    process.exit(1);
  }
}

// -- project rm ------------------------------------------------

async function projectRm(args) {
  const { flags, positional } = splitFlags(args);
  if (positional.length < 1) {
    console.error("Usage: yeet project rm <name> --pages");
    process.exit(1);
  }
  if (!flags.has("--pages")) {
    console.error("TinyFat site project deletion is not available to agents yet.");
    console.error("For legacy Pages deletion, run: yeet project rm <name> --pages");
    process.exit(1);
  }
  const name = positional[0];

  console.log(`Deleting legacy Pages project ${name}...`);
  const res = await api(`${DEPLOY_URL}/projects/${encodeURIComponent(name)}`, {
    method: "DELETE",
  });

  if (res.ok) {
    console.log(`Deleted: ${res.data.project}`);
  } else {
    console.error("Error:", res.data.error || res.data);
    process.exit(1);
  }
}

// ── project (router) ────────────────────────────────────────

async function projectCmd(args) {
  if (args.length === 0) {
    console.error("Usage: yeet project <init|use|ls|info|deploy|rollback|promote|resources|env|rm> [args]");
    process.exit(1);
  }
  const sub = args[0];
  const rest = args.slice(1);

  switch (sub) {
    case "init":
      return projectInit(rest);
    case "use":
      return projectUse(rest);
    case "ls":
      return projectLs(rest);
    case "info":
      return projectInfo(rest);
    case "deploy":
      return projectDeploy(rest);
    case "rollback":
      return projectRollback(rest);
    case "promote":
      return projectPromote(rest);
    case "resources":
      return projectResources(rest);
    case "env":
      return projectEnv(rest);
    case "rm":
      return projectRm(rest);
    default:
      console.error(`Unknown project command: ${sub}`);
      process.exit(1);
  }
}

// ── secret ──────────────────────────────────────────────────

async function secretCmd(args) {
  if (args.length === 0) {
    console.error("Usage: yeet secret ls|set|rm [KEY] [VALUE]");
    process.exit(1);
  }
  const action = args[0];

  if (action === "ls") {
    // The secrets API doesn't have a list endpoint — secrets are write-only
    // for security. Agents know what they saved.
    console.error("Listing secrets is not supported (write-only for security).");
    console.error("You know what you saved. Check your MEMORY.md for a record.");
    process.exit(1);
  }

  if (action === "set") {
    if (args.length < 2) {
      console.error("Usage: yeet secret set KEY=VALUE");
      process.exit(1);
    }
    // Support KEY=VALUE or KEY VALUE
    let key, value;
    if (args[1].includes("=")) {
      [key, ...rest] = args[1].split("=");
      value = rest.join("=");
    } else {
      key = args[1];
      value = args[2];
    }
    if (!key || value === undefined) {
      console.error("Usage: yeet secret set KEY=VALUE");
      process.exit(1);
    }

    const res = await api(`${PLATFORM_URL}/api/agent/secrets`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ [key]: value }),
    });

    if (res.ok) {
      console.log(`Saved secret: ${key}`);
      console.log("It will be available on next container wake.");
    } else {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
  } else if (action === "rm") {
    console.error("Secret deletion is not yet supported.");
    console.error("The secrets API is merge-only. To effectively disable a secret,");
    console.error("overwrite it: yeet secret set KEY=disabled");
    process.exit(1);
  } else {
    console.error(`Unknown action: ${action}`);
    console.error("Usage: yeet secret ls|set|rm [KEY] [VALUE]");
    process.exit(1);
  }
}

// ── contact ─────────────────────────────────────────────────

async function contactCmd(args) {
  if (args.length === 0) {
    console.error("Usage: yeet contact ls|add|rm [email]");
    process.exit(1);
  }
  const action = args[0];

  if (action === "ls") {
    const res = await api(`${PLATFORM_URL}/api/agent/contacts`);
    if (res.ok) {
      const contacts = Array.isArray(res.data) ? res.data : res.data.contacts || [];
      if (contacts.length === 0) {
        console.log("No contacts.");
      } else {
        console.log("Contacts:");
        for (const c of contacts) {
          const flags = [];
          if (c.inbound) flags.push("inbound");
          if (c.outbound) flags.push("outbound");
          console.log(`  ${c.email}  (${flags.join(", ")})`);
        }
      }
    } else {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
  } else if (action === "add") {
    if (args.length < 2) {
      console.error("Usage: yeet contact add <email>");
      process.exit(1);
    }
    const email = args[1];
    const matchType = email.startsWith("@") ? "domain" : "exact";

    const res = await api(`${PLATFORM_URL}/api/agent/contacts`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, match_type: matchType }),
    });

    if (res.ok) {
      console.log(`Added contact: ${email}`);
    } else {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
  } else if (action === "rm") {
    if (args.length < 2) {
      console.error("Usage: yeet contact rm <email>");
      process.exit(1);
    }
    const email = args[1];

    const res = await api(`${PLATFORM_URL}/api/agent/contacts?email=${encodeURIComponent(email)}`, {
      method: "DELETE",
    });

    if (res.ok) {
      console.log(`Removed contact: ${email}`);
    } else {
      console.error("Error:", res.data.error || res.data);
      process.exit(1);
    }
  } else {
    console.error(`Unknown action: ${action}`);
    console.error("Usage: yeet contact ls|add|rm [email]");
    process.exit(1);
  }
}

// ── task ────────────────────────────────────────────────────

function taskCmd(args) {
  // Task state lives on R2 mount so it survives container sleep
  const tdDir = "/data/.td";
  const env = { ...process.env, TD_DIR: tdDir };

  // Parse -p/--project flag
  let project = null;
  const tdArgs = [];
  for (let i = 0; i < args.length; i++) {
    if ((args[i] === "-p" || args[i] === "--project") && args[i + 1]) {
      project = args[i + 1];
      i++; // skip value
    } else {
      tdArgs.push(args[i]);
    }
  }

  if (project) {
    env.TD_PROJECT = project;
  }

  // Translate yeet shortcuts to td commands
  const aliases = { ls: "list", add: "create", done: "close" };
  if (tdArgs[0] && aliases[tdArgs[0]]) {
    tdArgs[0] = aliases[tdArgs[0]];
  }

  if (tdArgs.length === 0) {
    tdArgs.push("list");
  }

  try {
    execSync(`td ${tdArgs.map((a) => `'${a.replace(/'/g, "'\\''")}'`).join(" ")}`, {
      env,
      stdio: "inherit",
    });
  } catch (err) {
    // td already printed its error, just exit with its code
    process.exit(err.status || 1);
  }
}

// ── who ─────────────────────────────────────────────────────

async function whoCmd() {
  const token = process.env.FAT_TOOLS_TOKEN;
  console.log("Agent Platform Status:");
  console.log(`  FAT_TOOLS_TOKEN: ${token ? "set" : "NOT SET"}`);
  console.log(`  ANTHROPIC_API_KEY: ${process.env.ANTHROPIC_API_KEY ? "set" : "not set"}`);
  console.log(`  GH_TOKEN: ${process.env.GH_TOKEN ? "set" : "not set"}`);
  console.log(`  Node: ${process.version}`);
  console.log(`  Platform: ${PLATFORM_URL}`);
  console.log(`  Deploy: ${DEPLOY_URL}`);
  console.log(`  Sites: ${SITES_PUBLISH_URL}`);
  const project = readProjectConfig();
  if (project?.name) {
    console.log(`  Current project: ${project.name} (${project.kind || PROJECT_KIND_SITE})`);
  }
}

// ── help ────────────────────────────────────────────────────

function showHelp() {
  console.log(`yeet — agent platform CLI

Usage: yeet <command> [args]

Site Projects:
  yeet project init <name> [dir]       Create/select a TinyFat site project
  yeet project use <name> [dir]        Set current project in yeet.json
  yeet project deploy [dir]            Publish configured project
  yeet project deploy <name> <dir>     Publish without yeet.json
  yeet project deploy --preview        Publish to https://<name>-preview.preview.tinyfat.dev/
  yeet project rollback [name] [id]    Redeploy a previous rollback-ready version
  yeet project promote [name] [id]     Promote a preview deploy to the canonical URL
  yeet project resources add d1        Provision DB and bind it as env.DB
  yeet project resources add kv CACHE  Provision KV with a custom binding
  yeet project resources add r2 MEDIA  Provision R2 bucket storage
  yeet project resources ls [name]     List project resource bindings
  yeet project ls                      List TinyFat site projects
  yeet project info [name]             Site details + deploy history

Direct Site Publishing:
  yeet site deploy <name> [dir]        Publish static site via Workers for Platforms
  yeet site deploy <name> [dir] --preview

Legacy Pages:
  yeet project init <name> --pages     Create an old Cloudflare Pages project
  yeet project deploy <name> [dir] --pages
  yeet project ls --pages
  yeet project info <name> --pages
  yeet project env <name> set K=V      Set env var on legacy Pages
  yeet project env <name> rm KEY       Remove env var from legacy Pages
  yeet project rm <name> --pages       Delete legacy Pages project

Agent Secrets (persist across sleep):
  yeet secret set KEY=VALUE            Save a secret

Contacts (email whitelist):
  yeet contact ls                      List contacts
  yeet contact add <email>             Add contact (inbound + outbound)
  yeet contact add @domain.com         Add entire domain
  yeet contact rm <email>              Remove contact

Tasks (persist across sleep):
  yeet task ls [-p <project>]          List tasks
  yeet task add [-p <project>] "title" Create task
  yeet task done <id>                  Complete task
  yeet task <any td command>           Full td CLI pass-through

Other:
  yeet who                             Show agent status
  yeet help                            This message

All commands use FAT_TOOLS_TOKEN for authentication unless they only update local yeet.json.`);
}

// ── main ────────────────────────────────────────────────────

async function main() {
  const args = process.argv.slice(2);

  if (args.length === 0 || args[0] === "help" || args[0] === "--help" || args[0] === "-h") {
    showHelp();
    process.exit(0);
  }

  const cmd = args[0];
  const rest = args.slice(1);

  try {
    switch (cmd) {
      case "project":
        return await projectCmd(rest);
      case "site":
        return await siteCmd(rest);
      case "secret":
        return await secretCmd(rest);
      case "contact":
        return await contactCmd(rest);
      case "who":
        return await whoCmd();
      case "task":
        return taskCmd(rest);
      default:
        console.error(`Unknown command: ${cmd}`);
        showHelp();
        process.exit(1);
    }
  } catch (err) {
    console.error(`Error: ${err.message}`);
    process.exit(1);
  }
}

main();
